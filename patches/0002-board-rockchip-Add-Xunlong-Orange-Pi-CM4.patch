@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Xunlong Orange Pi CM4 v1.4.
+ *
+ * Ethernet PHY I/O is 1.8V with reset on GPIO4_C4, matching the vendor
+ * rk3566-orangepi-cm4-v1.4.dts and the Orange Pi 3B v2.1 split.
+ */
+
+/dts-v1/;
+
+#include "rk3566-orangepi-cm4.dtsi"
+
+/ {
+	model = "Xunlong Orange Pi CM4 v1.4";
+	compatible = "xunlong,orangepi-cm4-v1.4", "xunlong,orangepi-cm4", "rockchip,rk3566";
+
+	vccio_phy: regulator-1v8-vccio-phy {
+		compatible = "regulator-fixed";
+		regulator-name = "vccio_phy";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+};
+
+&pmu_io_domains {
+	vccio5-supply = <&vccio_phy>;
+};
+
+&gmac1 {
+	phy-handle = <&rgmii_phy1>;
+	status = "okay";
+};
+
+&mdio1 {
+	rgmii_phy1: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0>;
+		reset-assert-us = <20000>;
+		reset-deassert-us = <50000>;
+		reset-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_LOW>;
+	};
+};
