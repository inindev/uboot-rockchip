+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Xunlong Orange Pi CM4 (original revision).
+ *
+ * Ethernet PHY I/O is 3.3V with reset on GPIO3_C2, matching the vendor
+ * rk3566-orangepi-cm4.dts and the Orange Pi 3B v1.1 split.
+ */
+
+/dts-v1/;
+
+#include "rk3566-orangepi-cm4.dtsi"
+
+/ {
+	model = "Xunlong Orange Pi CM4";
+	compatible = "xunlong,orangepi-cm4", "rockchip,rk3566";
+};
+
+&pmu_io_domains {
+	vccio5-supply = <&vcc_3v3>;
+};
+
+&gmac1 {
+	phy-handle = <&rgmii_phy1>;
+	status = "okay";
+};
+
+&mdio1 {
+	rgmii_phy1: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0>;
+		reset-assert-us = <20000>;
+		reset-deassert-us = <50000>;
+		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
+	};
+};
